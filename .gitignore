# ══════════════════════════════════════
# Athlete Pro / Fit Elite — .gitignore
# ══════════════════════════════════════

# ===== СЕКРЕТЫ =====
.env
.env.*
!.env.example
*.pem
*.key
certs/
data/
*.sync.json
sync.json

# ===== Claude Code =====
# settings.local.json = личные ключи/MCP → НЕ коммитить
# settings.json + launch.json = командные правила → КОММИТИТЬ
.claude/settings.local.json
# Worktrees: temporary copies created by Claude agents — never commit
.claude/worktrees/
.gemini/

# ===== Агентские артефакты (Antigravity, планировщики, Lighthouse CI) =====
# Заход Antigravity принёс 89 таких файлов в ветку elite-hud-wow — к продукту
# отношения не имеют, живут у агента на машине.
.agents/
.lighthouseci/
# ВНИМАНИЕ: .planning/ уже отслеживается в main (легаси-дерево; счёт добывать
# командой `git ls-files .planning/`, число в комментарии протухнет).
# Правило закрывает только НОВЫЕ файлы; расчистка отслеживаемого — отдельным решением.
.planning/

# ===== Посторонние файлы с машины =====
# config.json / dictionary.txt / log.txt — конфиг переключателя раскладки ParanoidSwitcher,
# попал в чекаут случайно. Пути якорём от корня: одноимённые файлы в подпапках legit.
/config.json
/dictionary.txt
/log.txt
/icon-64.png
/ORIGINAL_REQUEST.md
/PROJECT.md

# ===== Node =====
node_modules/
dist/
build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ===== Logs =====
logs/
*.log

# ===== OS =====
.DS_Store
Thumbs.db
Desktop.ini

# ===== IDE / редакторы =====
# Игнорируем личные настройки, но НЕ extensions.json
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
# Obsidian — личные настройки редактора, в любой папке
.obsidian/
*.canvas

# ===== Deploy =====
.vercel/
android/

# ===== Артефакты тестов и аудитов =====
coverage/
*.lcov
test-results/
test/e2e/report/
playwright-report/
blob-report/
.eslintcache
.stylelintcache
test_results.txt

# ===== Полевое тестирование =====
# (telemetry.log покрыт *.log выше)

# ===== Вендорнутое / внешние копии =====
# Скачанный набор скиллов, 40 МБ, к продукту отношения не имеет
Anthropic-Cybersecurity-Skills-main/
gitleaks.exe
ATH-PRO vanilla google/

# ===== Одноразовые скрипты и мусор кодогенерации =====
recovered_code/
/add_crop.js
/add_crop.cjs
/debug_line.js
/extract_athlete_room.js
/fix_escape.js
/rebuild_shared.js
/recover.js
/search_content.js
/search_logs.js
/phase*.js
/purge_*.js
# мёртвое в scripts/ (живые: build-sw.mjs, import-etl.py, lighthouse.js, telemetry-server.mjs)
scripts/_poc_*.py
scripts/phase-verify.js
scripts/verify-phase4.js
scripts/version-manager.js
