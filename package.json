{
  "name": "athlete-pro",
  "version": "1.27.194",
  "type": "module",
  "description": "PPL Workout Tracker with AI Coach",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "dev:lan": "node --watch server.js --lan",
    "lint": "eslint . && stylelint \"css/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test \"test/*.test.js\"",
    "test:e2e": "playwright test --config=playwright.config.js",
    "test:all": "node --test \"test/*.test.js\" && playwright test --config=playwright.config.js",
    "lhci": "node scripts/lighthouse.js",
    "preflight": "node scripts/preflight.mjs",
    "inventory": "node scripts/branch-inventory.mjs",
    "scorecard": "node scripts/agent-scorecard.mjs",
    "brief:gate": "node scripts/check-brief-gate.mjs",
    "prefix:check": "node scripts/check-branch-prefix.mjs",
    "docs:budget": "node scripts/check-docs-budget.mjs",
    "tokens": "node scripts/token-economy.mjs",
    "memory:ttl": "node scripts/memory-ttl.mjs",
    "smoke:prod": "node scripts/smoke-prod.mjs",
    "security:audit": "node scripts/sca-audit.mjs --retries=3",
    "security:sast": "npm run lint",
    "security:check": "npm run security:audit && npm run security:sast",
    "postinstall": "node scripts/fix-hooks-path.mjs || exit 0",
    "build:sw": "node scripts/build-sw.mjs",
    "vendor:supabase": "node scripts/vendor-supabase.mjs",
    "build": "npm run build:sw"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@google/genai": "^2.24.0",
    "@supabase/supabase-js": "^2.118.0",
    "@upstash/redis": "^1.39.0",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "qs": "6.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.11.0",
    "eslint-plugin-security": "^4.0.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.6",
    "stylelint": "^17.15.0"
  }
}
