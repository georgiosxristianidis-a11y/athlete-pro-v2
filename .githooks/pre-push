#!/bin/sh

# Elite SCA Protocol (Solid 9)
# pre-push hook: Runs npm audit only when pushing, blocking vulnerable code.

# -2. Что именно уезжает на origin. git подаёт в stdin по строке на каждый
# обновляемый ref: "<local ref> <local sha> <remote ref> <remote sha>". Это
# единственный источник правды о рефспеке — рабочее дерево и имя HEAD про него
# не знают ничего.
# stdin у хука одноразовый: вычитали — держим в переменной, второй раз не
# прочитать. Потребителей ниже по цепочке нет: scripts/check-branch-drift.mjs
# не обращается ни к stdin, ни к argv, он добывает всё сам из git.
push_refs=$(cat)

# -1. Прямой пуш в main запрещён (CLAUDE.md § Rules) — вливание только через
# PR после гейта. GitHub branch protection недоступна на приватном репо
# бесплатного плана (403 на branches/main/protection), так что единственный
# реальный барьер — этот хук. Осознанный обход: MAIN_PUSH_OK=1 git push.
#
# Судим по ЦЕЛЕВОЙ стороне рефспека, а не по имени текущей ветки (O-9,
# 2026-08-12): форма `git push origin HEAD:main` уезжает в main с любой
# фича-ветки, HEAD при этом называется не main, и проверка по имени пропускала
# такой пуш насквозь — мимо единственного барьера, который у репо есть.
# Пустой stdin = хук вызван не гитом (ручной прогон): рефспека нет, остаётся
# прежняя эвристика по имени HEAD.
#
# Тем же проходом считаем удаления: у них `local sha` — одни нули (сорок для
# sha1, шестьдесят четыре для sha256), а `local ref` — литерал `(delete)`.
pushes_to_main=0
refs_seen=0
deletes_seen=0
target_branches=''
if [ -n "$push_refs" ]; then
  while read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "$remote_ref" ] && continue
    refs_seen=$((refs_seen + 1))
    if [ "$remote_ref" = "refs/heads/main" ]; then
      pushes_to_main=1
    fi
    case "$local_sha" in
      '' | *[!0]*)
        # Живой (не удаляющий) пуш — целевое имя ветки пойдёт гарду префикса
        # (AGENT-8). Судим по той же ЦЕЛЕВОЙ стороне, что и Main Block:
        # `git push origin HEAD:cursor/x` называет ветку именно здесь.
        case "$remote_ref" in
          refs/heads/*) target_branches="$target_branches ${remote_ref#refs/heads/}" ;;
        esac
        ;;
      *) deletes_seen=$((deletes_seen + 1)) ;;
    esac
  done <<PUSH_REFS
$push_refs
PUSH_REFS
else
  [ "$(git symbolic-ref --short HEAD 2>/dev/null)" = "main" ] && pushes_to_main=1
fi

if [ "$pushes_to_main" = "1" ] && [ "$MAIN_PUSH_OK" != "1" ]; then
  echo "❌ [Main Block] Прямой пуш в main запрещён — только через PR."
  echo "   git checkout -b <ветка> && git push -u origin <ветка> && gh pr create --base main"
  echo "   Осознанный обход: MAIN_PUSH_OK=1 git push"
  exit 1
fi

# 0a. Пуш из одних удалений. Кода на origin такой пуш не отправляет, поэтому
# проверять в нём нечего: дрейф разбирает ветку, которая к удаляемому ref-у
# отношения не имеет, SCA и SAST — рабочее дерево, которого пуш не касается.
# Baseline O-9 (2026-08-12): удаление уже влитой ветки было заблокировано и
# Drift Block, и SAST Block — обе жалобы про ЧУЖУЮ линию в чекауте ворктри,
# а удалялся ref, не несущий ни строки кода. `DRIFT_OK=1` снял только первый
# гард. Цена ложного блока — не минута, а привычка тянуться к `--no-verify`,
# который глушит уже и настоящие проверки.
# Удаление `main` сюда не доходит: Main Block выше судит по `remote ref` и
# ловит его раньше, независимо от того, чем этот ref обновляют.
if [ "$refs_seen" -gt 0 ] && [ "$refs_seen" -eq "$deletes_seen" ]; then
  echo "[Delete] Пуш только удаляет рефы — кода не уезжает, гарды пропущены."
  exit 0
fi

# 0. Дрейф базы. Идёт ПЕРВЫМ и намеренно раньше SCA/SAST: те проверяют уязвимости
# и стиль, то есть КАЧЕСТВО кода, и обе спокойно зеленеют на коде трёхнедельной
# давности. Кейс PP-6 (2026-07-29): «pre-push SAST/SCA прошёл» прозвучало как
# «всё хорошо», хотя ветка отставала на 233 коммита и откатывала 4 влитые карточки.
# Сначала отвечаем на вопрос «этот код вообще про сегодняшний main?», потом на
# все остальные.
# Скрипта нет = чекаут старше самого гарда. Это ровно тот случай, который гард
# и ловит, поэтому падаем внятно, а не через MODULE_NOT_FOUND от node.
if [ ! -f scripts/check-branch-drift.mjs ]; then
  echo "❌ [Drift Block] scripts/check-branch-drift.mjs не найден."
  echo "   Значит этот чекаут старше гарда — то есть заведомо устарел."
  echo "   git fetch origin && git rebase origin/main"
  echo "   Осознанный обход: DRIFT_OK=1 git push"
  [ "$DRIFT_OK" = "1" ] || exit 1
fi

node scripts/check-branch-drift.mjs
if [ $? -ne 0 ]; then
  exit 1
fi

# 0b. Префикс ветки называет инструмент (AGENT-8). Дёшево и без сети: гард
# читает трейлеры коммитов ветки и сверяет их с ИМЕНЕМ, под которым работа
# уезжает на origin. Стоит после дрейфа сознательно — дрейф отвечает на вопрос
# «этот код вообще про сегодняшний main?», и он важнее гигиены имени.
# Скрипта нет = чекаут старше гарда; здесь это не блок, в отличие от дрейфа:
# неверное имя ветки переименовывается, а работа по протухшей базе — нет.
if [ -f scripts/check-branch-prefix.mjs ]; then
  node scripts/check-branch-prefix.mjs $target_branches
  if [ $? -ne 0 ]; then
    exit 1
  fi
fi

echo "🔒 [GIO Security] Running pre-push SCA check..."

# 1. SCA. Вердикт выносит scripts/sca-audit.mjs (AGENT-10): он отличает НАХОДКУ
# (блок) от ОТКАЗА ПРОВЕРКИ (громкий пропуск). Раньше здесь стоял голый
# `npm audit --omit=dev --audit-level=high`, и ЛЮБОЙ ненулевой код читался как
# «найдены уязвимости». 2026-09-19 этим кодом был 400 от registry — bulk-эндпоинт
# отдавал 503, npm падал на отставной quick, — и хук резал каждый пуш в проекте
# с текстом про несуществующие уязвимости. Цена такого блока — привычка тянуться
# к `--no-verify`, который снимает разом все четыре гарда этого файла.
#
# Пропуск проверки помечается переменной, а не выходом: он обязан прозвучать в
# конце, когда остальной вывод push уже уехал вверх.
sca_skipped=''

# Пинга `registry.npmjs.org` здесь больше нет. Он стоял быстрой отсечкой мёртвой
# сети, но как признак доступности АУДИТА был ложным: 2026-09-19 ICMP отвечал
# нормально ровно в тот день, когда audit-эндпоинт был мёртв (прямой замер:
# `bulk=503` при `quick=200` на пустом теле). То есть зелёный пинг доказывал не
# то, что проверяли, а красный — отсекал бы и живой реестр за фаерволом, режущим
# ICMP. Единственный честный источник «доступен ли аудит» — сама попытка аудита,
# и её исход гард уже разбирает по причинам.
#
# Цену отсечки вернул сам гард: повтор не делается, когда сети нет вовсе
# (ENOTFOUND/ECONNREFUSED и родня) — ждать 2.5 с нечего. Мёртвая сеть стоит
# примерно столько же, сколько стоил пинг; повторы остались там, где они
# осмысленны, — на отказе живого сервера.
if [ ! -f scripts/sca-audit.mjs ]; then
  # Чекаут старше гарда. Не блок: имя пропуска называется вслух, а качество кода
  # доберёт тот же гард в обязательном job `test`.
  sca_skipped='scripts/sca-audit.mjs нет в этом чекауте'
  echo "[SCA Skip] Проверка НЕ выполнена: $sca_skipped."
else
  # 2. Production-зависимости, как было. Дев-цепочку (stylelint → postcss) ловит
  # шаг `Security audit (high+)` в CI — он гоняет тот же скрипт без --omit-dev.
  #
  # `--on-unavailable=signal`: отказ проверки обязан отличаться от чистого отчёта
  # КОДОМ, иначе хук заканчивает бодрым «Security Pass» на непроведённой проверке
  # (поймано живым прогоном этой же карточки). 3 = не проверено, 1 = находка.
  node scripts/sca-audit.mjs --omit-dev --on-unavailable=signal
  sca_code=$?
  if [ $sca_code -eq 3 ]; then
    # Точную причину гард уже назвал строкой выше — пересказывать её здесь
    # значило бы заводить второй источник правды, который разъедется первым же.
    sca_skipped='причина названа выше'
  elif [ $sca_code -ne 0 ]; then
    exit $sca_code
  fi
fi

echo "🔍 Running Static Analysis (SAST)..."
npm run lint -- --cache
if [ $? -ne 0 ]; then
  echo "❌ [SAST Block] Linting/Security errors found."
  exit 1
fi

if [ -n "$sca_skipped" ]; then
  echo "[Security Pass] SAST пройден. Напоминание: SCA в этом пуше НЕ выполнен ($sca_skipped)."
else
  echo "✅ [Security Pass] Pushing..."
fi
exit 0
