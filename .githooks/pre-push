#!/bin/sh

# Elite SCA Protocol (Solid 9)
# pre-push hook: Runs npm audit only when pushing, blocking vulnerable code.

# -2. Что именно уезжает на origin. git подаёт в stdin по строке на каждый
# обновляемый ref: "<local ref> <local sha> <remote ref> <remote sha>". Это
# единственный источник правды о рефспеке — рабочее дерево и имя HEAD про него
# не знают ничего.
# stdin у хука одноразовый: вычитали — держим в переменной, второй раз не
# прочитать. Потребителей ниже по цепочке нет: scripts/check-branch-drift.mjs
# не обращается ни к stdin, ни к argv, он добывает всё сам из git.
push_refs=$(cat)

# -1. Прямой пуш в main запрещён (CLAUDE.md § Rules) — вливание только через
# PR после гейта. GitHub branch protection недоступна на приватном репо
# бесплатного плана (403 на branches/main/protection), так что единственный
# реальный барьер — этот хук. Осознанный обход: MAIN_PUSH_OK=1 git push.
#
# Судим по ЦЕЛЕВОЙ стороне рефспека, а не по имени текущей ветки (O-9,
# 2026-08-12): форма `git push origin HEAD:main` уезжает в main с любой
# фича-ветки, HEAD при этом называется не main, и проверка по имени пропускала
# такой пуш насквозь — мимо единственного барьера, который у репо есть.
# Пустой stdin = хук вызван не гитом (ручной прогон): рефспека нет, остаётся
# прежняя эвристика по имени HEAD.
pushes_to_main=0
if [ -n "$push_refs" ]; then
  while read -r local_ref local_sha remote_ref remote_sha; do
    if [ "$remote_ref" = "refs/heads/main" ]; then
      pushes_to_main=1
    fi
  done <<PUSH_REFS
$push_refs
PUSH_REFS
else
  [ "$(git symbolic-ref --short HEAD 2>/dev/null)" = "main" ] && pushes_to_main=1
fi

if [ "$pushes_to_main" = "1" ] && [ "$MAIN_PUSH_OK" != "1" ]; then
  echo "❌ [Main Block] Прямой пуш в main запрещён — только через PR."
  echo "   git checkout -b <ветка> && git push -u origin <ветка> && gh pr create --base main"
  echo "   Осознанный обход: MAIN_PUSH_OK=1 git push"
  exit 1
fi

# 0. Дрейф базы. Идёт ПЕРВЫМ и намеренно раньше SCA/SAST: те проверяют уязвимости
# и стиль, то есть КАЧЕСТВО кода, и обе спокойно зеленеют на коде трёхнедельной
# давности. Кейс PP-6 (2026-07-29): «pre-push SAST/SCA прошёл» прозвучало как
# «всё хорошо», хотя ветка отставала на 233 коммита и откатывала 4 влитые карточки.
# Сначала отвечаем на вопрос «этот код вообще про сегодняшний main?», потом на
# все остальные.
# Скрипта нет = чекаут старше самого гарда. Это ровно тот случай, который гард
# и ловит, поэтому падаем внятно, а не через MODULE_NOT_FOUND от node.
if [ ! -f scripts/check-branch-drift.mjs ]; then
  echo "❌ [Drift Block] scripts/check-branch-drift.mjs не найден."
  echo "   Значит этот чекаут старше гарда — то есть заведомо устарел."
  echo "   git fetch origin && git rebase origin/main"
  echo "   Осознанный обход: DRIFT_OK=1 git push"
  [ "$DRIFT_OK" = "1" ] || exit 1
fi

node scripts/check-branch-drift.mjs
if [ $? -ne 0 ]; then
  exit 1
fi

echo "🔒 [GIO Security] Running pre-push SCA check..."

# 1. Check Airgap mode (Ping registry.npmjs.org)
# -c 1 means 1 packet, -W 2 means 2 seconds timeout. On Windows it's -n 1 -w 2000
ping -n 1 -w 2000 registry.npmjs.org > /dev/null 2>&1

if [ $? -ne 0 ]; then
  echo "⚠️  [Airgap Mode] Network unreachable. Skipping npm audit to prevent block."
  exit 0
fi

# 2. Run SCA on production dependencies only, tracking High/Critical
echo "📡 Network active. Scanning for High/Critical vulnerabilities..."

# npm audit --omit=dev --audit-level=high
npm audit --omit=dev --audit-level=high

if [ $? -ne 0 ]; then
  echo ""
  echo "❌ [SCA Block] Push rejected! High or Critical vulnerabilities found in production dependencies."
  echo "Please run 'npm audit fix' or update the affected packages before pushing."
  exit 1
fi

echo "✅ [SCA Pass] No high/critical vulnerabilities found."

echo "🔍 Running Static Analysis (SAST)..."
npm run lint -- --cache
if [ $? -ne 0 ]; then
  echo "❌ [SAST Block] Linting/Security errors found."
  exit 1
fi

echo "✅ [Security Pass] Pushing..."
exit 0
