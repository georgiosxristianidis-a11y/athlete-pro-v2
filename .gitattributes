# .gitignore uses box-drawing characters in its section headers, which trips
# git's binary heuristic — its diffs then show up as "Bin 1476 -> 2221 bytes"
# and become unreviewable. Force a textual diff.
.gitignore diff

# sw.js генерируется (`npm run build:sw`), и обе стороны любого пересечения —
# машинные: CACHE_NAME пересчитывается от содержимого репозитория, поэтому две
# ветки, тронувшие js/ или css/, конфликтуют по нему всегда. Кейс PR #255
# (карточка AGENT-5): конфликт вставал на каждом из четырёх коммитов ветки.
#
# Разрешать руками нельзя — выбранная сторона стирает чужой прекеш (так уже
# терялся /_vercel/* из влитого PR). Правильный ход один: взять версию базы,
# довести ребейз, затем `npm run build:sw` пересчитает дайджест от финального
# дерева. Драйвер `ours` делает ровно первый шаг (при rebase «ours» — это
# upstream, то есть main), остальное — за пересборкой.
#
# Забыть пересборку не страшно: sw.js разойдётся с деревом и `npm test`
# покраснеет на test/sw-cache-name.test.js (карточка O-8).
#
# Драйвер объявляется в postinstall — scripts/fix-hooks-path.mjs.
sw.js merge=ours
